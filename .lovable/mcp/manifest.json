{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://eltunbflazenamwgyvzl.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "livenotebook-mcp",
      "version": "0.1.0",
      "title": "LiveNotebook"
    },
    "tools": [
      {
        "name": "list_students",
        "title": "List students",
        "description": "List the signed-in teacher's students (name, subject, days per week, status).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_lessons",
        "title": "List lessons",
        "description": "List lessons in a date range (YYYY-MM-DD) for the signed-in teacher.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start date, YYYY-MM-DD"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "End date, YYYY-MM-DD"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_finance",
        "title": "List payments",
        "description": "List finance/payment records for the signed-in teacher.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_homework",
        "title": "List homework",
        "description": "List homework entries for the signed-in teacher's students.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "set_lesson_status",
        "title": "Set lesson status",
        "description": "Update the status of one existing lesson owned by the signed-in teacher. Allowed values: planned, completed, cancelled, moved.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "lesson_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID of the lesson to update"
            },
            "status": {
              "type": "string",
              "enum": [
                "planned",
                "completed",
                "cancelled",
                "moved"
              ],
              "description": "New lesson status"
            }
          },
          "required": [
            "lesson_id",
            "status"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
